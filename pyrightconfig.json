{
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "include": [
    "backend"
  ],
  "exclude": [
    "backend/firduty.db",
    "**/__pycache__",
    "**/*.pyc"
  ],
  "extraPaths": [
    "backend",
    "backend/models",
    "backend/routers",
    "backend/schemas",
    "backend/services",
    "backend/jobs"
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none",
  "reportMissingModuleSourceFiles": "none",
  "reportUnusedImport": "none",
  "reportPrivateUsage": "none",
  "executionEnvironments": [
    {
      "root": "backend",
      "pythonVersion": "3.12",
      "extraPaths": [
        "backend",
        "backend/models",
        "backend/routers",
        "backend/schemas",
        "backend/services",
        "backend/jobs"
      ]
    },
    {
      "root": "backend/jobs",
      "pythonVersion": "3.12",
      "extraPaths": [
        "backend",
        "backend/models",
        "backend/schemas",
        "backend/services"
      ]
    }
  ]
}