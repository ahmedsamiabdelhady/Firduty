# ─────────────────────────────────────────────────────────────────────────────
# Firduty Backend — Environment Variables  (v2.3.0)
# Copy this file to .env for local development:
#   cp .env.example .env
# In production (Koyeb), set these directly as environment variables.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED in production) ─────────────────────────────────────────
# Get this from Supabase → Project Settings → Database → URI
DATABASE_URL=postgresql://postgres:As%4081113795@db.szbcfletjkmdgfpcpmbs.supabase.co:5432/postgres

# ── JWT (REQUIRED in production) ──────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-64-character-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Admin Credentials (REQUIRED in production) ────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ── Firebase / FCM (Android push notifications) ───────────────────────────────
# Path to your downloaded Firebase service account JSON file.
# Option A — file on disk (local dev / Koyeb Secrets volume):
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# Option B — inline JSON string (Koyeb free tier, no volume):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── VAPID Keys (Web Push — iOS PWA + desktop browsers) ────────────────────────
# Firebase delivers FCM web tokens via Web Push using these VAPID keys.
#
# Generate once using py-vapid:
#   pip install py-vapid
#   vapid --gen
#   # → outputs vapid_private.pem and vapid_public.pem
#   # or use online generator: https://web-push-codelab.glitch.me/
#
# IMPORTANT:
#   VAPID_PUBLIC_KEY must also be set in:
#     flutter_app/lib/firebase_options.dart  → kVapidPublicKey
#     flutter_app/web/firebase-messaging-sw.js (not directly, but used by FCM)
#
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_CONTACT_EMAIL=admin@yourschool.com

# ── Server ────────────────────────────────────────────────────────────────────
# PORT is injected automatically by Koyeb. Only set for local dev.
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Production example:
#   ALLOWED_ORIGINS=https://admin.yourschool.com,https://firduty.netlify.app
# Local dev (permissive):
ALLOWED_ORIGINS=*

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Set to false on additional Koyeb instances to prevent duplicate job runs.
RUN_SCHEDULER=true
SCHEDULER_JITTER=30
