# ─────────────────────────────────────────────────────────────────────────────
# Firduty Backend — Environment Variables
# Copy this file to .env for local development:
#   cp .env.example .env
# In production (Koyeb), set these directly as environment variables.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED in production) ─────────────────────────────────────────
# Get this from Supabase → Project Settings → Database → URI
# Replace [YOUR-PASSWORD] with your actual Supabase database password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── JWT (REQUIRED in production) ──────────────────────────────────────────────
# Generate a secure random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-64-character-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Admin Credentials (REQUIRED in production) ────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# ── Firebase (optional — push notifications disabled if missing) ───────────────
# Path to your downloaded Firebase service account JSON file.
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ── Server ────────────────────────────────────────────────────────────────────
# PORT is injected automatically by Koyeb. Only needed for local dev.
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set this to your actual admin UI domain:
#   ALLOWED_ORIGINS=https://admin.yourschool.com
# For local dev, * is fine:
ALLOWED_ORIGINS=*

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Set to "false" on extra Koyeb instances to prevent duplicate job runs.
RUN_SCHEDULER=true
SCHEDULER_JITTER=30
